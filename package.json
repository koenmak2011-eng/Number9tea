{
  "name": "no9-bubble-tea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cms:sync": "node scripts/sync-cms.mjs",
    "cms:check": "node scripts/sync-cms.mjs --check",
    "predev": "npm run cms:sync",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run cms:sync",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests *.json *.md"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.13.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
